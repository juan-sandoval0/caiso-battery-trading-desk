# OpenRouter — required for MarketIntelAgent.
# Routes the same Anthropic model (anthropic/claude-sonnet-4.6) via OpenRouter's
# Anthropic-compatible Messages API.
OPENROUTER_API_KEY=sk-or-v1-...
# Base URL for OpenRouter (the anthropic SDK appends /v1/messages). Override only
# if you proxy OpenRouter; leave unset to use the default.
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# GridStatus — optional; increases rate limits for bulk CAISO fetches
GRIDSTATUS_API_KEY=

# DuckDB path — defaults to data/market.duckdb if unset
DUCKDB_PATH=data/market.duckdb

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paper-trading node (default NP15 hub)
DEFAULT_NODE=TH_NP15_GEN-APND
