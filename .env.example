# Anthropic — required for MarketIntelAgent
ANTHROPIC_API_KEY=sk-ant-...

# GridStatus — optional; increases rate limits for bulk CAISO fetches
GRIDSTATUS_API_KEY=

# DuckDB path — defaults to data/market.duckdb if unset
DUCKDB_PATH=data/market.duckdb

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paper-trading node (default NP15 hub)
DEFAULT_NODE=TH_NP15_GEN-APND
